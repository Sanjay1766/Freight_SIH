# =============================================================================
# OceanPulse Production & Development Environment Configuration
# =============================================================================

# Groq API Key (Configure in Render Dashboard or .env.local)
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here

# Backend API Endpoint URL
# Local Development: http://127.0.0.1:8000
# Render Production: https://oceanpulse-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend CORS configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://oceanpulse-frontend.onrender.com

# Pipeline live scraping refresh
ENABLE_PIPELINE_REFRESH=false
