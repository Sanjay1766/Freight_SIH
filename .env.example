# =============================================================================
# OceanPulse Environment Configuration — .env.example
# Copy to .env.local for local development. DO NOT commit .env.local to git.
#
# Deployment is split across two hosts:
#   • Backend  → Render  (https://oceanpulse-backend.onrender.com)
#   • Frontend → Netlify (https://oceanpulse.netlify.app) or Render static site
#
# Secrets must be set independently in each host's dashboard:
#   • Render:  Dashboard > Your Service > Environment > Add Environment Variable
#   • Netlify: Site configuration > Environment variables
# =============================================================================

# ---------------------------------------------------------------------------
# BACKEND secrets (set in Render dashboard — never commit real values)
# ---------------------------------------------------------------------------

# Groq API Key — required for live AI Copilot LLM responses.
# If unset, the copilot falls back to offline rule-based mode (logged as WARNING at startup).
# Get your key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Allowed CORS origins for the FastAPI backend (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-netlify-site.netlify.app

# Enable live scraper pipeline on each request (true = live market data; false = cached only)
# Set to true on Render; keep false locally unless you're debugging scrapers.
ENABLE_PIPELINE_REFRESH=false

# ---------------------------------------------------------------------------
# FRONTEND secrets (set in Netlify dashboard OR Render static site env)
# Vite exposes only VITE_* prefixed variables to the browser bundle.
# ---------------------------------------------------------------------------

# The same Groq key used client-side (if your app makes direct Groq calls from the browser)
VITE_GROQ_API_KEY=your_groq_api_key_here

# URL of the backend API (no trailing slash)
# Local dev:  http://127.0.0.1:8000
# Production: https://oceanpulse-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
