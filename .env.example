# Copy this file to .env or .env.local and fill in your actual API keys.
# NEVER commit .env files containing real keys to Git repository!

# Example API Key Configuration for Vite Apps
VITE_API_KEY=your_api_key_here
# VITE_OPENAI_API_KEY=your_openai_key_here
# URL of the FastAPI service. Leave local for development.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend configuration (set these in the backend environment, not in a Vite file).
# Keep refresh disabled outside a local administrator session: it scrapes data and refits models.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_PIPELINE_REFRESH=false
